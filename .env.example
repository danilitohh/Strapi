# Copia este archivo como .env y pega el JWT solamente en STRAPI_API_TOKEN.
STRAPI_API_TOKEN=pega_aqui_el_jwt_de_strapi

STRAPI_BASE_URL=https://api-stg.utel.edu.mx
STRAPI_PRODUCTS_PATH=/api/products
STRAPI_LOCALE=es-MX
STRAPI_PAGE_SIZE=100

# Rutas internas del JSON devuelto por Strapi. Se confirman con: npm run inspect
STRAPI_SLUG_PATH=slug
STRAPI_HREFLANGS_PATH=seo.MultipleHrefLangs

# Consulta populate sin el signo ? inicial. Ajustar después de inspeccionar Strapi.
STRAPI_POPULATE_QUERY=populate[seo][populate]=*

HTTP_TIMEOUT_MS=12000
HTTP_CONCURRENCY=8
